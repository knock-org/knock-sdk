{
  "name": "knockai",
  "version": "0.1.0",
  "description": "Knock AI SDK \u2014 identify people, send events and open the Knock widget from your website or your logged-in app. Zero dependencies.",
  "license": "MIT",
  "homepage": "https://knock-ai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/knock-org/knock-sdk.git"
  },
  "keywords": [
    "knock",
    "knock-ai",
    "sdk",
    "analytics",
    "identify",
    "widget",
    "scheduling"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/core/index.d.ts",
  "typesVersions": {
    "<4.7": {
      "react": [
        "./dist/types/frameworks/react/index.d.ts"
      ],
      "vue": [
        "./dist/types/frameworks/vue/index.d.ts"
      ],
      "angular": [
        "./dist/types/frameworks/angular/index.d.ts"
      ],
      "testing": [
        "./dist/types/testing/index.d.ts"
      ],
      "contract": [
        "./dist/types/core/contract.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/core/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/core/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/frameworks/react/index.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/types/frameworks/react/index.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/types/frameworks/vue/index.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/types/frameworks/vue/index.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/types/frameworks/angular/index.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/types/frameworks/angular/index.d.cts",
        "default": "./dist/angular.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/types/testing/index.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/types/testing/index.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/types/core/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/types/core/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    },
    "./snippet": "./dist/snippet.js",
    "./iife": "./dist/knockai.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "react",
    "vue",
    "angular",
    "testing",
    "contract",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && tsc -p tsconfig.build.json && node scripts/finalize-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "check": "npm run typecheck && npm run test && npm run build && npm run size && npm run snippet:check",
    "snippet:sync": "node scripts/sync-snippet.mjs",
    "snippet:check": "node scripts/sync-snippet.mjs --check"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^20.0.0",
    "@size-limit/preset-small-lib": "^11.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "zone.js": "^0.15.0"
  },
  "size-limit": [
    {
      "name": "core (knockai)",
      "path": "dist/index.js",
      "limit": "1.7 kB",
      "gzip": true
    },
    {
      "name": "react",
      "path": "dist/react.js",
      "limit": "700 B",
      "gzip": true,
      "ignore": [
        "knockai",
        "react"
      ]
    },
    {
      "name": "vue",
      "path": "dist/vue.js",
      "limit": "0.6 kB",
      "gzip": true,
      "ignore": [
        "knockai",
        "vue"
      ]
    },
    {
      "name": "angular",
      "path": "dist/angular.js",
      "limit": "0.8 kB",
      "gzip": true,
      "ignore": [
        "knockai",
        "@angular/core",
        "rxjs"
      ]
    },
    {
      "name": "contract (policy constants)",
      "path": "dist/contract.js",
      "limit": "250 B",
      "gzip": true
    },
    {
      "name": "snippet (CDN stub)",
      "path": "dist/snippet.js",
      "limit": "600 B",
      "gzip": true
    },
    {
      "name": "knockai.iife (CDN)",
      "path": "dist/knockai.iife.js",
      "limit": "1.9 kB",
      "gzip": true
    }
  ]
}
